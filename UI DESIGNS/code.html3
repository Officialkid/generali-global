                    Request Quotation
                </button>
</div>
</div>
</nav>
<!-- Main Content -->
<main class="flex-grow pt-32 pb-24 px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto w-full">
<!-- Grid Layout -->
