<style>
        .glass-panel {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(40px);
            border: 1px solid rgba(218, 165, 32, 0.2);
        }
        .executive-accent {
            position: absolute;
            top: -1px;
            left: -1px;
            width: 24px;
            height: 24px;
            border-top: 2px solid #DAA520;
            border-left: 2px solid #DAA520;
        }
        .holographic-divider {
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(218, 165, 32, 0.5), transparent);
        }
        .glow-hover:hover {
            box-shadow: 0 0 20px rgba(218, 165, 32, 0.4);
        }
    </style>
</head>
<body class="bg-background text-on-surface min-h-screen flex flex-col font-body-md overflow-x-hidden">
<!-- TopNavBar -->
<nav class="fixed top-0 w-full bg-background/80 backdrop-blur-xl border-b border-primary/20 shadow-[0_20px_50px_rgba(218,165,32,0.05)] flex justify-between items-center px-margin-mobile md:px-margin-desktop py-4 z-50">
<div class="font-display-lg text-display-lg-mobile md:text-display-lg text-primary tracking-tighter">DANIEL GENERATION</div>
<div class="hidden md:flex gap-gutter font-label-caps text-label-caps">
<a class="text-on-surface-variant hover:text-primary transition-colors hover:bg-white/5 transition-all duration-300 px-4 py-2 rounded-DEFAULT active:scale-95 transition-transform" href="#">Home</a>
<a class="text-on-surface-variant hover:text-primary transition-colors hover:bg-white/5 transition-all duration-300 px-4 py-2 rounded-DEFAULT active:scale-95 transition-transform" href="#">Our Ventures</a>
<a class="text-on-surface-variant hover:text-primary transition-colors hover:bg-white/5 transition-all duration-300 px-4 py-2 rounded-DEFAULT active:scale-95 transition-transform" href="#">Meet The Founder</a>
<a class="text-primary border-b-2 border-primary pb-1 px-4 py-2 active:scale-95 transition-transform" href="#">Institute</a>
<a class="text-on-surface-variant hover:text-primary transition-colors hover:bg-white/5 transition-all duration-300 px-4 py-2 rounded-DEFAULT active:scale-95 transition-transform" href="#">Events</a>
</div>
<div class="flex items-center gap-4">
<span class="material-symbols-outlined text-primary hover:bg-white/5 transition-all duration-300 p-2 rounded-full cursor-pointer active:scale-95 transition-transform" data-icon="notifications">notifications</span>
<img alt="Executive Profile" class="w-10 h-10 rounded-full border border-primary/50 object-cover" data-alt="A detailed hyper-realistic portrait of an executive leader in a dark, atmospheric boardroom setting. The lighting is moody with gold cybernetic accents highlighting the subject's sharp features, conveying absolute authority and visionary presence. Shot on 85mm lens." src="https://lh3.googleusercontent.com/aida-public/AB6AXuBqQXrGt5aBP3_FjYIbgB2CK4t_QL_zmH1sfU233Nasq7P8TEeUZguTnfRf9gTBszXiES7B45pOLEYR1NDaW21_afJekPUIGyy3nbM6jo3vDDw5RRNiEUXHNcL_ZxAQRAFRbLl9epET-gBw47mpPAlsoQGb8Qin9dxJg4T73FSm1DFZA3BGzKuhwiU3Xmana0XRIl7Hwr3OhmxPH5AIAaOBu-knv-Y4euyXMUEa_p7P5K6qVGJPvTSX"/>
</div>
</nav>
<!-- Main Content -->
<main class="flex-grow pt-[100px] md:pt-[120px] px-margin-mobile md:px-margin-desktop pb-24 max-w-container-max mx-auto w-full relative">
<!-- Background Accent -->
<div class="absolute inset-0 z-[-1] opacity-20 pointer-events-none">
<div class="bg-cover bg-center w-full h-full" data-alt="A dark, obsidian-themed abstract background with glowing gold cybernetic waves and intersecting luminous hairlines. The visual style is futuristic, elegant, and minimal, resembling a high-tech biometric security grid or a conceptual data flow matrix in a premium corporate setting." style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuChVxX34sdGezyFKrPqJ9PyFn5IBIwgBjYJ1jyzoyW9ir1q_uwhs8-WUjluzPm9iYtrenrmRJNRfSrt5MBVUWk2vLltvNjulyHZmOOUQ5nMP2LJlC0OmOOOUzAQTUZ9GZjDz6ttXHaAoBqBn1oKMm2SmsSy4TKjAUUievsOnK-DVEItcNumXX45h-3BV3ua1hmSbbaTvjMM4rqNE7rDu9pxQVt28qolF9AyROBHixSD4w0vB_aWwwhj')"></div>
</div>
<!-- Header Section -->
<header class="text-center mb-16 md:mb-24 mt-8 md:mt-16">
<h1 class="font-display-xl text-headline-lg-mobile md:text-display-xl text-primary mb-6">Mastering the Unspoken: Behavioral Dynamics &amp; Executive Presence</h1>
<p class="font-body-lg text-body-lg text-on-surface-variant max-w-3xl mx-auto">Daniels Institute of Body Language, Executive Presence &amp; Behavioural Intelligence</p>
</header>
<div class="holographic-divider mb-16 w-full max-w-4xl mx-auto"></div>
<!-- Interactive Booking Selector -->
<div class="flex justify-center mb-16">
<div class="glass-panel rounded-full p-2 flex flex-wrap gap-2 justify-center border-primary/30">
<button class="font-label-caps text-label-caps bg-primary text-on-primary px-6 py-3 rounded-full transition-all glow-hover">Corporate Workshops</button>
<button class="font-label-caps text-label-caps text-primary px-6 py-3 rounded-full border border-transparent hover:border-primary/50 transition-all">1-on-1 Executive Coaching</button>
<button class="font-label-caps text-label-caps text-primary px-6 py-3 rounded-full border border-transparent hover:border-primary/50 transition-all">Institutional Masterclasses</button>
</div>
</div>
<!-- Interactive Masterclass Matrix (2x2 Bento) -->
<div class="grid grid-cols-1 md:grid-cols-2 gap-gutter max-w-5xl mx-auto mb-24 relative z-10">
<!-- Module 01 -->
<div class="glass-panel p-8 rounded-xl relative group overflow-hidden flex flex-col h-full min-h-[300px]">
<div class="executive-accent"></div>
<div class="absolute right-4 top-4 text-primary/30 font-display-lg text-4xl opacity-50">01</div>
<h3 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-primary mb-4 z-10 relative">Micro-Expressions &amp; Deception Detection</h3>
<p class="font-body-md text-body-md text-on-surface-variant z-10 relative flex-grow">Analyze micro-movements and baseline deviations to identify concealed emotions and establish truthful baselines.</p>
<div class="absolute inset-0 z-0 opacity-20 group-hover:opacity-40 transition-opacity duration-500 pointer-events-none">
<img alt="Biometric Analysis" class="w-full h-full object-cover mix-blend-screen" data-alt="Do not replace this image." src="https://lh3.googleusercontent.com/aida/AEtjO1XGnTOHITVeNxh6I9hNJHOhN1y8lJp7zSosi3PImYqgpqcXMhZhPu31lCLZsR5qk5jWP1tzGHPfvfbL9ck6JH62YEdJpE3a6mVuCwN7YH-KL8TbETEMYEBcCzuTOHAht1GyPcPhk3w0a65fhkF3HQQdjdHpZsu-_dqGzuFGagStc2sXx0TTjMFpVjtuUWdDWYQTDXMezVcpSJYQSse8LD2vSwacFCQud-iGfmY48hTcmx8xe8jrr_vInus"/>
</div>
<div class="mt-6 flex justify-between items-center z-10 relative">
<span class="font-label-caps text-label-caps text-primary border-b border-transparent group-hover:border-primary transition-all cursor-pointer">Explore Module</span>
<span class="material-symbols-outlined text-primary" data-icon="arrow_forward">arrow_forward</span>
</div>
</div>
<!-- Module 02 -->
<div class="glass-panel p-8 rounded-xl relative group overflow-hidden flex flex-col h-full min-h-[300px]">
<div class="executive-accent"></div>
<div class="absolute right-4 top-4 text-primary/30 font-display-lg text-4xl opacity-50">02</div>
<h3 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-primary mb-4 z-10 relative">Executive Presence &amp; Boardroom Authority</h3>
<p class="font-body-md text-body-md text-on-surface-variant z-10 relative flex-grow">Command the room through intentional posture, pacing, and non-verbal anchors. Cultivate an aura of absolute leadership.</p>
<div class="mt-6 flex justify-between items-center z-10 relative">
<span class="font-label-caps text-label-caps text-primary border-b border-transparent group-hover:border-primary transition-all cursor-pointer">Explore Module</span>
<span class="material-symbols-outlined text-primary" data-icon="arrow_forward">arrow_forward</span>
</div>
</div>
<!-- Module 03 -->
<div class="glass-panel p-8 rounded-xl relative group overflow-hidden flex flex-col h-full min-h-[300px]">
<div class="executive-accent"></div>
<div class="absolute right-4 top-4 text-primary/30 font-display-lg text-4xl opacity-50">03</div>
<h3 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-primary mb-4 z-10 relative">High-Stakes Negotiation &amp; Behavioral Profiling</h3>
<p class="font-body-md text-body-md text-on-surface-variant z-10 relative flex-grow">Read counter-parties dynamically. Anticipate objections and leverage emotional cues to secure favorable outcomes in critical deals.</p>
<div class="mt-6 flex justify-between items-center z-10 relative">
<span class="font-label-caps text-label-caps text-primary border-b border-transparent group-hover:border-primary transition-all cursor-pointer">Explore Module</span>
<span class="material-symbols-outlined text-primary" data-icon="arrow_forward">arrow_forward</span>
</div>
</div>
<!-- Module 04 -->
<div class="glass-panel p-8 rounded-xl relative group overflow-hidden flex flex-col h-full min-h-[300px]">
<div class="executive-accent"></div>
<div class="absolute right-4 top-4 text-primary/30 font-display-lg text-4xl opacity-50">04</div>
<h3 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-primary mb-4 z-10 relative">Corporate Team Dynamic Diagnostics</h3>
<p class="font-body-md text-body-md text-on-surface-variant z-10 relative flex-grow">Audit and optimize internal communication structures by mapping the unspoken hierarchies and tension points within your organization.</p>
<div class="mt-6 flex justify-between items-center z-10 relative">
<span class="font-label-caps text-label-caps text-primary border-b border-transparent group-hover:border-primary transition-all cursor-pointer">Explore Module</span>
<span class="material-symbols-outlined text-primary" data-icon="arrow_forward">arrow_forward</span>
</div>
</div>
</div>
</main>
<!-- Floating CTA -->
<div class="fixed bottom-8 right-8 z-50 hidden md:block">
<button class="bg-primary text-on-primary font-label-caps text-label-caps px-8 py-4 rounded-full shadow-[0_10px_30px_rgba(218,165,32,0.3)] hover:shadow-[0_15px_40px_rgba(218,165,32,0.6)] transition-all duration-300 flex items-center gap-2 transform hover:-translate-y-1">
<span class="material-symbols-outlined" data-icon="download">download</span>
            Download Curriculum / Book Training
        </button>
</div>
<!-- Mobile Floating CTA -->
<div class="fixed bottom-0 w-full z-50 md:hidden p-4 bg-background/90 backdrop-blur-md border-t border-primary/20">
<button class="bg-primary text-on-primary font-label-caps text-label-caps w-full py-4 rounded-lg shadow-lg hover:shadow-xl transition-all duration-300 flex items-center justify-center gap-2">
<span class="material-symbols-outlined" data-icon="calendar_today">calendar_today</span>
            Book Training
        </button>
</div>
<!-- Footer -->
<footer class="bg-surface-container-lowest text-primary font-body-md text-body-md w-full border-t border-primary/10 flat no shadows flex flex-col md:flex-row justify-between items-center px-margin-mobile md:px-margin-desktop py-12 gap-gutter mt-auto z-40 relative">
