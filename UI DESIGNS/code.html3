<style>
        body {
            background-color: #0A0A0A;
            background-image: 
                radial-gradient(circle at 15% 50%, rgba(218, 165, 32, 0.03) 0%, transparent 50%),
                radial-gradient(circle at 85% 30%, rgba(218, 165, 32, 0.04) 0%, transparent 50%);
            background-attachment: fixed;
        }

        .glass-panel {
            background: rgba(10, 10, 10, 0.6);
            backdrop-filter: blur(40px);
            border: 1px solid rgba(218, 165, 32, 0.2);
            box-shadow: 0 20px 50px rgba(218,165,32,0.05);
        }

        .gold-hairline {
            border: 1px solid rgba(218, 165, 32, 0.2);
        }
        
        .gold-hairline-bottom {
            border-bottom: 1px solid rgba(218, 165, 32, 0.2);
        }

        .holographic-divider {
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(218, 165, 32, 0.4), transparent);
        }

        .executive-corner {
            position: relative;
        }
        .executive-corner::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 24px;
            height: 24px;
            border-top: 1px solid #DAA520;
            border-left: 1px solid #DAA520;
            z-index: 10;
        }

        .btn-primary {
            background-color: #DAA520;
            color: #000;
            transition: all 0.3s ease;
        }
        .btn-primary:hover {
            box-shadow: 0 0 20px rgba(218, 165, 32, 0.4);
        }

        .portrait-frame {
            position: relative;
            z-index: 1;
        }
        .portrait-frame::after {
            content: '';
            position: absolute;
            inset: -4px;
            background: linear-gradient(45deg, rgba(218, 165, 32, 0.1), transparent, rgba(218, 165, 32, 0.3));
            z-index: -1;
            filter: blur(10px);
            border-radius: 4px;
        }

        /* Nav active state logic */
        /* Executive matches our subject */
    </style>
</head>
<body class="text-on-surface antialiased flex flex-col min-h-screen font-body-md overflow-x-hidden">
