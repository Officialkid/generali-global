            </div>
<div class="hidden md:flex items-center gap-8 font-label-caps text-label-caps">
<!-- Active Item: Executive -->
<a class="text-primary font-bold border-b-2 border-primary pb-1 hover:text-primary transition-colors duration-300 transform active:scale-95" href="#">Executive</a>
<a class="text-on-surface-variant hover:text-primary transition-colors duration-300 transform active:scale-95" href="#">Ventures</a>
<a class="text-on-surface-variant hover:text-primary transition-colors duration-300 transform active:scale-95" href="#">Philanthropy</a>
<a class="text-on-surface-variant hover:text-primary transition-colors duration-300 transform active:scale-95" href="#">Perspective</a>
</div>
<div class="hidden md:block">
